# Optional: enables the GraphQL calendar and increases public PR search limits.
# All GitHub requests target Nareshtiwari74; public PRs work without a token.
GITHUB_TOKEN=

# Optional legacy guestbook/RAG backend. Leave empty to use native guestbook.
NEXT_PUBLIC_PORTFOLIO_API_URL=
NEXT_PUBLIC_CAL_LINK=naresh-tiwari-vfj1ak/30min
# Google Calendar appointment booking-page link, with Google Meet configured.
NEXT_PUBLIC_BOOKING_URL=
# Your Discord user ID; join https://discord.gg/lanyard to expose presence.
NEXT_PUBLIC_DISCORD_USER_ID=

# Coding time can be enabled independently of Spotify and visitor counts.
WAKATIME_ENABLED=false
WAKATIME_TIMEZONE=Asia/Kolkata
WAKATIME_API_KEY=

# Spotify can be enabled independently after authorizing Naresh's account.
# Register this exact redirect in your Spotify Developer app settings.
SPOTIFY_ENABLED=false
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Written privately by: node scripts/connect-spotify.mjs
SPOTIFY_REFRESH_TOKEN=

# Native Google sign-in and comments use the same database as visitor counts.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Random secret (at least 32 characters); never use a NEXT_PUBLIC prefix.
GUESTBOOK_SESSION_SECRET=
# Change to https://www.nareshdev.space for production.
GUESTBOOK_ORIGIN=http://localhost:3000

# Visitor counts need Naresh's own fresh Neon PostgreSQL database and migrations.
VISITOR_COUNT_ENABLED=false
DATABASE_URL=
DIRECT_URL=

# Legacy switch for enabling all configured activity services together.
PORTFOLIO_ACTIVITY_ENABLED=false

# Optional analytics for Naresh's own projects.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
NEXT_PUBLIC_VERCEL_ANALYTICS_ENABLED=false
